# ─────────────────────────────────────────────────────────────
# Variables de entorno · Generador de Contenido HTML
# Copia este archivo a .env.local (local) o configúralas en Vercel.
# .env* está en .gitignore: NUNCA se suben claves al repositorio.
# ─────────────────────────────────────────────────────────────

# Modo API + Vercel Postgres (por defecto, para el despliegue en Vercel):

# Clave de la API de Anthropic. Se usa para llamar al modelo claude-sonnet-4-6.
ANTHROPIC_API_KEY=

# Cadena de conexión de Vercel Postgres. Vercel la conecta automáticamente
# al crear la base de datos y enlazarla al proyecto.
POSTGRES_URL=

# ─────────────────────────────────────────────────────────────
# Modo LOCAL (opcional). Ponlo en .env.local para desarrollar en tu máquina
# usando el CLI de Claude (tu suscripción, sin coste de API) + archivos locales.
# En este modo NO hacen falta las dos variables de arriba.
#
# USE_LOCAL_STORAGE=true
